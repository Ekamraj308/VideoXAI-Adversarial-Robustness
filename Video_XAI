      "source": [
        "# =========================\n",
        "# FULL, FIXED VIDEOXAI PIPELINE\n",
        "# =========================\n",
        "\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "!pip install -q torch torchvision torchaudio transformers sentence-transformers bert-score einops opencv-python matplotlib tqdm imageio rouge-score nltk kaggle scikit-learn\n",
        "\n",
        "import os, math, json, random\n",
        "from pathlib import Path\n",
        "import numpy as np, cv2, imageio\n",
        "from PIL import Image\n",
        "import torch\n",
        "from tqdm import tqdm\n",
        "from transformers import BlipProcessor, BlipForConditionalGeneration, CLIPProcessor, CLIPModel\n",
        "from sentence_transformers import SentenceTransformer, util\n",
        "from bert_score import score as bertscore_score\n",
        "from rouge_score import rouge_scorer\n",
        "from nltk.translate.bleu_score import sentence_bleu\n",
        "from scipy import linalg\n",
        "import pandas as pd\n",
        "from sklearn.metrics import pairwise_distances\n",
        "\n",
        "# -------------------------\n",
        "# Device\n",
        "# -------------------------\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "print(\"Device:\", device)\n",
        "\n",
        "OUT_ROOT = Path('/content/videoXAI_outputs')\n",
        "OUT_ROOT.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# -------------------------\n",
        "# Video loader\n",
        "# -------------------------\n",
        "def load_video_frames(video_path, num_frames=12, resize=(224,224)):\n",
        "    cap = cv2.VideoCapture(str(video_path))\n",
        "    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT)) or 0\n",
        "\n",
        "    if total <= 0:\n",
        "        raise RuntimeError(f\"Cannot read frames from {video_path}\")\n",
        "\n",
        "    idxs = np.linspace(0, total-1, min(num_frames, total)).astype(int)\n",
        "\n",
        "    frames, i = [], 0\n",
        "    ret, frame = cap.read()\n",
        "\n",
        "    while ret:\n",
        "        if i in idxs:\n",
        "            frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
        "            frame = cv2.resize(frame, resize)\n",
        "            frames.append(frame)\n",
        "        ret, frame = cap.read()\n",
        "        i += 1\n",
        "\n",
        "    cap.release()\n",
        "\n",
        "    # ✅ FIX: check empty frames\n",
        "    if len(frames) == 0:\n",
        "        raise RuntimeError(f\"No frames extracted from {video_path}\")\n",
        "\n",
        "    # ✅ FIX: properly inside function\n",
        "    while len(frames) < num_frames:\n",
        "        frames.append(frames[-1].copy())\n",
        "\n",
        "    return np.array(frames)\n",
        "\n",
        "# -------------------------\n",
        "# Models\n",
        "# -------------------------\n",
        "processor_blip = BlipProcessor.from_pretrained(\"Salesforce/blip-image-captioning-base\")\n",
        "model_blip = BlipForConditionalGeneration.from_pretrained(\n",
        "    \"Salesforce/blip-image-captioning-base\"\n",
        ").to(device).eval()\n",
        "\n",
        "clip_processor = CLIPProcessor.from_pretrained(\"openai/clip-vit-base-patch32\")\n",
        "clip_model = CLIPModel.from_pretrained(\"openai/clip-vit-base-patch32\").to(device).eval()\n",
        "\n",
        "sbert_model = SentenceTransformer(\"sentence-transformers/all-MiniLM-L6-v2\", device=device)\n",
        "\n",
        "# ---- SAFE processor access\n",
        "fe = getattr(clip_processor, \"feature_extractor\", None)\n",
        "if fe is None:\n",
        "    fe = getattr(clip_processor, \"image_processor\")\n",
        "\n",
        "MEAN = np.array(fe.image_mean).reshape(1,1,3)\n",
        "STD  = np.array(fe.image_std).reshape(1,1,3)\n",
        "\n",
        "scorer = rouge_scorer.RougeScorer(['rouge1'], use_stemmer=True)\n",
        "\n",
        "# -------------------------\n",
        "# Caption helper\n",
        "# -------------------------\n",
        "def caption_from_frames(frames):\n",
        "    mid = frames[len(frames)//2]\n",
        "    inputs = processor_blip(images=mid, return_tensors=\"pt\").to(device)\n",
        "    with torch.no_grad():\n",
        "        out = model_blip.generate(**inputs, max_new_tokens=40)\n",
        "    return processor_blip.decode(out[0], skip_special_tokens=True)\n",
        "\n",
        "# -------------------------\n",
        "# CLIP SAFE EMBEDDING HELPERS\n",
        "# -------------------------\n",
        "def get_text_embed(text):\n",
        "    out = clip_model.get_text_features(\n",
        "        **clip_processor(text=[text], return_tensors=\"pt\").to(device)\n",
        "    )\n",
        "    if not torch.is_tensor(out):\n",
        "        out = out.pooler_output\n",
        "    return out / (out.norm(dim=-1, keepdim=True) + 1e-10)\n",
        "\n",
        "def get_image_embed(pv):\n",
        "    out = clip_model.get_image_features(pixel_values=pv)\n",
        "    if not torch.is_tensor(out):\n",
        "        out = out.pooler_output\n",
        "    return out / (out.norm(dim=-1, keepdim=True) + 1e-10)\n",
        "\n",
        "# -------------------------\n",
        "# VBAD\n",
        "# -------------------------\n",
        "def vbad_like_patch_attack(frames, patch_ratio=0.06, seed=42):\n",
        "    np.random.seed(seed)\n",
        "    T,H,W,_ = frames.shape\n",
        "    out = frames.copy()\n",
        "    ps = max(4, int(math.sqrt(H*W*patch_ratio)))\n",
        "    for t in range(T):\n",
        "        x = np.random.randint(0, max(1, W-ps))\n",
        "        y = np.random.randint(0, max(1, H-ps))\n",
        "        for i in range(ps):\n",
        "            for j in range(ps):\n",
        "                out[t, y+i, x+j] = [255,0,0] if (i+j)%2==0 else [255,255,255]\n",
        "    return out\n",
        "\n",
        "# -------------------------\n",
        "# FGSM\n",
        "# -------------------------\n",
        "def fgsm_attack_video(frames_np, caption, eps=0.08):\n",
        "    # TEXT EMBEDDING — NO GRAPH\n",
        "    with torch.no_grad():\n",
        "        txt = get_text_embed(caption)\n",
        "\n",
        "    out = []\n",
        "    for f in frames_np:\n",
        "        pv = clip_processor(\n",
        "            images=Image.fromarray(f),\n",
        "            return_tensors=\"pt\"\n",
        "        ).to(device)[\"pixel_values\"]\n",
        "\n",
        "        pv = pv.clone().detach().requires_grad_(True)\n",
        "\n",
        "        img = get_image_embed(pv)\n",
        "        loss = torch.cosine_similarity(img, txt, dim=-1).mean()\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        adv = pv - eps * pv.grad.sign()\n",
        "        adv = adv.detach().squeeze().permute(1,2,0).cpu().numpy()\n",
        "        adv = ((adv * STD + MEAN) * 255).clip(0,255).astype(np.uint8)\n",
        "\n",
        "        out.append(adv)\n",
        "\n",
        "    return np.array(out)\n",
        "\n",
        "# -------------------------\n",
        "# -------------------------\n",
        "# PGD (Fully Safe + Version Compatible)\n",
        "# -------------------------\n",
        "def pgd_attack_video(frames_np, caption, eps=0.03, iters=6, alpha=0.01):\n",
        "\n",
        "    # ----- TEXT EMBEDDING (SAFE FOR ALL TRANSFORMERS VERSIONS) -----\n",
        "    with torch.no_grad():\n",
        "        text_inputs = clip_processor(text=[caption], return_tensors=\"pt\").to(device)\n",
        "        text_emb = clip_model.get_text_features(**text_inputs)\n",
        "\n",
        "        # 🔥 Handle BaseModelOutputWithPooling\n",
        "        if not torch.is_tensor(text_emb) and hasattr(text_emb, \"pooler_output\"):\n",
        "            text_emb = text_emb.pooler_output\n",
        "\n",
        "        text_emb = text_emb / (text_emb.norm(p=2, dim=-1, keepdim=True) + 1e-10)\n",
        "\n",
        "    text_emb = text_emb.detach()  # fully detached, graph safe\n",
        "\n",
        "    out = []\n",
        "\n",
        "    for f in frames_np:\n",
        "\n",
        "        pil = Image.fromarray(f.astype(np.uint8))\n",
        "        inputs = clip_processor(images=pil, return_tensors=\"pt\").to(device)\n",
        "\n",
        "        pv_orig = inputs[\"pixel_values\"].detach()\n",
        "        pv = pv_orig.clone().detach().requires_grad_(True)\n",
        "\n",
        "        for _ in range(iters):\n",
        "\n",
        "            if pv.grad is not None:\n",
        "                pv.grad.zero_()\n",
        "\n",
        "            img_feat = clip_model.get_image_features(pixel_values=pv)\n",
        "\n",
        "            # 🔥 Handle possible output wrapper\n",
        "            if not torch.is_tensor(img_feat) and hasattr(img_feat, \"pooler_output\"):\n",
        "                img_feat = img_feat.pooler_output\n",
        "\n",
        "            img_feat = img_feat / (img_feat.norm(p=2, dim=-1, keepdim=True) + 1e-10)\n",
        "\n",
        "            sim = torch.nn.functional.cosine_similarity(img_feat, text_emb, dim=-1).mean()\n",
        "\n",
        "            sim.backward()\n",
        "\n",
        "            # ----- PGD UPDATE -----\n",
        "            grad = pv.grad.sign()\n",
        "            pv = pv.detach() - alpha * grad\n",
        "\n",
        "            # L∞ projection\n",
        "            delta = torch.clamp(pv - pv_orig, min=-eps, max=eps)\n",
        "            pv = torch.clamp(pv_orig + delta, 0.0, 1.0)\n",
        "\n",
        "            pv = pv.detach().requires_grad_(True)\n",
        "\n",
        "        # ----- Convert back to image -----\n",
        "        adv = pv.detach().squeeze().permute(1,2,0).cpu().numpy()\n",
        "        adv = ((adv * STD + MEAN) * 255).clip(0,255).astype(np.uint8)\n",
        "\n",
        "        out.append(adv)\n",
        "\n",
        "    return np.array(out)\n",
        "# -------------------------\n",
        "def i2v_attack_video(frames_np, caption, eps=0.03, iters=6, alpha=0.01):\n",
        "\n",
        "    # ---- TEXT EMBEDDING (SAFE DETACHED) ----\n",
        "    with torch.no_grad():\n",
        "        text_inputs = clip_processor(text=[caption], return_tensors=\"pt\").to(device)\n",
        "        text_emb = clip_model.get_text_features(**text_inputs)\n",
        "\n",
        "    if not torch.is_tensor(text_emb) and hasattr(text_emb, \"pooler_output\"):\n",
        "        text_emb = text_emb.pooler_output\n",
        "\n",
        "    text_emb = text_emb / (text_emb.norm(p=2, dim=-1, keepdim=True) + 1e-10)\n",
        "    text_emb = text_emb.detach()\n",
        "\n",
        "    # ---- FRAMES ----\n",
        "    frames = torch.tensor(frames_np / 255.0, device=device).permute(0,3,1,2).float()\n",
        "    delta = torch.zeros_like(frames, requires_grad=True)\n",
        "\n",
        "    mean_ch = torch.tensor(MEAN.reshape(3), device=device).view(1,3,1,1)\n",
        "    std_ch  = torch.tensor(STD.reshape(3), device=device).view(1,3,1,1)\n",
        "\n",
        "    for _ in range(iters):\n",
        "\n",
        "        if delta.grad is not None:\n",
        "            delta.grad.zero_()\n",
        "\n",
        "        adv = torch.clamp(frames + delta, 0.0, 1.0)\n",
        "        adv_norm = (adv - mean_ch) / std_ch\n",
        "\n",
        "        img_feat = clip_model.get_image_features(pixel_values=adv_norm)\n",
        "\n",
        "        if not torch.is_tensor(img_feat) and hasattr(img_feat, \"pooler_output\"):\n",
        "            img_feat = img_feat.pooler_output\n",
        "\n",
        "        img_feat = img_feat / (img_feat.norm(p=2, dim=-1, keepdim=True) + 1e-10)\n",
        "\n",
        "        loss = torch.nn.functional.cosine_similarity(img_feat, text_emb, dim=-1).mean()\n",
        "        loss.backward()\n",
        "\n",
        "        with torch.no_grad():\n",
        "            delta -= alpha * delta.grad.sign()\n",
        "            delta.data = torch.clamp(delta.data, -eps, eps)\n",
        "\n",
        "        # 🔥 CRITICAL FIX\n",
        "        delta = delta.detach().requires_grad_(True)\n",
        "\n",
        "    adv_final = torch.clamp(frames + delta.detach(), 0.0, 1.0)\n",
        "    return (adv_final.cpu().numpy().transpose(0,2,3,1) * 255).astype(np.uint8)\n",
        "# -------------------------\n",
        "# RUN\n",
        "# -------------------------\n",
        "# METRIC HELPERS\n",
        "# -------------------------\n",
        "\n",
        "def compute_psnr(a, b):\n",
        "    mse = np.mean((a.astype(np.float32)/255.0 - b.astype(np.float32)/255.0) ** 2)\n",
        "    if mse == 0:\n",
        "        return 100.0\n",
        "    return 20 * math.log10(1.0 / math.sqrt(mse))\n",
        "\n",
        "def compute_linf(a, b):\n",
        "    return float(np.max(np.abs(a.astype(np.float32)/255.0 - b.astype(np.float32)/255.0)))\n",
        "\n",
        "def text_metrics(ref, hyp):\n",
        "    bleu1 = sentence_bleu([ref.split()], hyp.split(), weights=(1,0,0,0))\n",
        "    rouge = scorer.score(ref, hyp)[\"rouge1\"].fmeasure\n",
        "    P,R,F1 = bertscore_score([hyp], [ref], lang=\"en\", verbose=False)\n",
        "    sbert = util.cos_sim(\n",
        "        sbert_model.encode(ref, convert_to_tensor=True),\n",
        "        sbert_model.encode(hyp, convert_to_tensor=True)\n",
        "    ).item()\n",
        "    return {\n",
        "        \"BLEU1\": float(bleu1),\n",
        "        \"ROUGE1_f\": float(rouge),\n",
        "        \"BERTScore_F1\": float(F1.mean().item()),\n",
        "        \"SBERT_cos\": float(sbert)\n",
        "    }\n",
        "\n",
        "# -------------------------\n",
        "# EPSILON SETTINGS (ALL 4 ATTACKS)\n",
        "# -------------------------\n",
        "\n",
        "eps_vbad = 0.06     # area ratio\n",
        "eps_fgsm = 0.08     # L∞\n",
        "eps_pgd  = 0.03     # L∞\n",
        "eps_i2v  = 0.03     # L∞\n",
        "\n",
        "# -------------------------\n",
        "# RUN WITH METRICS\n",
        "# -------------------------\n",
        "# -------------------------\n",
        "# -------------------------\n",
        "# LOAD 50 DOWNLOADED MED-CRAFT VIDEOS\n",
        "# -------------------------\n",
        "VIDEO_ROOT = \"/content/drive/MyDrive/medcraft_videos\"\n",
        "exts = [\".mp4\", \".webm\", \".mkv\", \".avi\", \".mov\"]\n",
        "\n",
        "videos = []\n",
        "for p in Path(VIDEO_ROOT).glob(\"*\"):\n",
        "    if p.suffix.lower() in exts:\n",
        "        videos.append(str(p))\n",
        "\n",
        "videos = sorted(videos)[:50]   # ✅ changed to 50\n",
        "\n",
        "print(\"Videos loaded:\", len(videos))\n",
        "print(\"First 5 videos:\", videos[:5])\n",
        "\n",
        "assert len(videos) > 0, \"No videos found in medcraft_videos\"\n",
        "\n",
        "print(\"Videos loaded:\", videos)\n",
        "from tqdm import tqdm\n",
        "\n",
        "print(\"Videos loaded:\", videos)\n",
        "\n",
        "for v in tqdm(videos):\n",
        "    try:\n",
        "        print(\"Processing:\", v)\n",
        "\n",
        "        frames = load_video_frames(v)\n",
        "        orig_cap = caption_from_frames(frames)\n",
        "\n",
        "        # -------------------------\n",
        "        # attacks\n",
        "        # -------------------------\n",
        "        vbad = vbad_like_patch_attack(frames, patch_ratio=eps_vbad)\n",
        "        fgsm = fgsm_attack_video(frames, orig_cap, eps=eps_fgsm)\n",
        "        pgd  = pgd_attack_video(frames, orig_cap, eps=eps_pgd)\n",
        "        i2v  = i2v_attack_video(frames, orig_cap, eps=eps_i2v)\n",
        "\n",
        "        # -------------------------\n",
        "        # captions\n",
        "        # -------------------------\n",
        "        vbad_cap = caption_from_frames(vbad)\n",
        "        fgsm_cap = caption_from_frames(fgsm)\n",
        "        pgd_cap  = caption_from_frames(pgd)\n",
        "        i2v_cap  = caption_from_frames(i2v)\n",
        "\n",
        "        # -------------------------\n",
        "        # distortion metrics\n",
        "        # -------------------------\n",
        "        psnr_vals = {\n",
        "            \"psnr_vbad\": np.mean([compute_psnr(frames[i], vbad[i]) for i in range(len(frames))]),\n",
        "            \"psnr_fgsm\": np.mean([compute_psnr(frames[i], fgsm[i]) for i in range(len(frames))]),\n",
        "            \"psnr_pgd\":  np.mean([compute_psnr(frames[i], pgd[i])  for i in range(len(frames))]),\n",
        "            \"psnr_i2v\":  np.mean([compute_psnr(frames[i], i2v[i])  for i in range(len(frames))])\n",
        "        }\n",
        "\n",
        "        linf_vals = {\n",
        "            \"linf_vbad\": np.mean([compute_linf(frames[i], vbad[i]) for i in range(len(frames))]),\n",
        "            \"linf_fgsm\": np.mean([compute_linf(frames[i], fgsm[i]) for i in range(len(frames))]),\n",
        "            \"linf_pgd\":  np.mean([compute_linf(frames[i], pgd[i])  for i in range(len(frames))]),\n",
        "            \"linf_i2v\":  np.mean([compute_linf(frames[i], i2v[i])  for i in range(len(frames))])\n",
        "        }\n",
        "\n",
        "        # -------------------------\n",
        "        # text metrics\n",
        "        # -------------------------\n",
        "        metrics_vbad = text_metrics(orig_cap, vbad_cap)\n",
        "        metrics_fgsm = text_metrics(orig_cap, fgsm_cap)\n",
        "        metrics_pgd  = text_metrics(orig_cap, pgd_cap)\n",
        "        metrics_i2v  = text_metrics(orig_cap, i2v_cap)\n",
        "\n",
        "        # -------------------------\n",
        "        # save outputs\n",
        "        # -------------------------\n",
        "        out = OUT_ROOT / Path(v).stem\n",
        "        out.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "        imageio.mimsave(out/\"orig.gif\", frames, fps=4)\n",
        "        imageio.mimsave(out/\"vbad.gif\", vbad, fps=4)\n",
        "        imageio.mimsave(out/\"fgsm.gif\", fgsm, fps=4)\n",
        "        imageio.mimsave(out/\"pgd.gif\",  pgd,  fps=4)\n",
        "        imageio.mimsave(out/\"i2v.gif\",  i2v,  fps=4)\n",
        "\n",
        "        summary = {\n",
        "            \"epsilon_vbad_area\": eps_vbad,\n",
        "            \"epsilon_fgsm_linf\": eps_fgsm,\n",
        "            \"epsilon_pgd_linf\": eps_pgd,\n",
        "            \"epsilon_i2v_linf\": eps_i2v,\n",
        "            \"orig_caption\": orig_cap,\n",
        "            \"vbad_caption\": vbad_cap,\n",
        "            \"fgsm_caption\": fgsm_cap,\n",
        "            \"pgd_caption\": pgd_cap,\n",
        "            \"i2v_caption\": i2v_cap,\n",
        "            **psnr_vals,\n",
        "            **linf_vals,\n",
        "            \"metrics_vbad\": metrics_vbad,\n",
        "            \"metrics_fgsm\": metrics_fgsm,\n",
        "            \"metrics_pgd\": metrics_pgd,\n",
        "            \"metrics_i2v\": metrics_i2v\n",
        "        }\n",
        "\n",
        "        with open(out/\"summary.json\", \"w\") as f:\n",
        "            json.dump(summary, f, indent=2)\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"❌ Skipping video:\", v)\n",
        "        print(\"Error:\", e)\n",
        "        continue\n",
        "\n",
        "print(\"✅ Full pipeline completed safely.\")"
